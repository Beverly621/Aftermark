# Task 01 defaults to the explicit development outer-art adapter.
AFTERMARK_ARTWORK_PROVIDER=development

# Set the provider to "http" and configure both values to use the production adapter.
# These values are read only by server modules and must never use a NEXT_PUBLIC_ prefix.
AFTERMARK_ARTWORK_PROVIDER_URL=
AFTERMARK_ARTWORK_PROVIDER_API_KEY=
AFTERMARK_ARTWORK_PROVIDER_MODEL=

# Task 02-B01 benchmark candidates. Keep real values in an ignored .env.local.
# Standard OPENAI_API_KEY, GEMINI_API_KEY / GOOGLE_API_KEY, and BFL_API_KEY
# names are also accepted by the benchmark runner.
AFTERMARK_OPENAI_API_KEY=
AFTERMARK_OPENAI_IMAGE_MODEL=gpt-image-2
AFTERMARK_OPENAI_COST_ESTIMATE_USD=

AFTERMARK_GOOGLE_API_KEY=
AFTERMARK_GOOGLE_IMAGE_MODEL=gemini-3-pro-image
AFTERMARK_GOOGLE_COST_ESTIMATE_USD=

AFTERMARK_BFL_API_KEY=
AFTERMARK_BFL_IMAGE_MODEL=flux-2-pro
