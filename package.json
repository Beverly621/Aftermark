{
  "name": "aftermark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:node && npm run test:runtime",
    "test:node": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:runtime": "python3 -m unittest discover -s tests/runtime -p 'test_*.py'",
    "benchmark:providers": "node --conditions=react-server --import tsx scripts/run-provider-benchmark.ts",
    "studio:prepare": "node --conditions=react-server --import tsx scripts/prepare-native-generation.ts",
    "studio:finalize": "node --conditions=react-server --import tsx scripts/finalize-native-generation.ts",
    "studio:process:development": "node --conditions=react-server --import tsx scripts/process-studio-request.ts",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "next": "^16.3.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
